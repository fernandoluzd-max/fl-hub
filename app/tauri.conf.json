{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FL Hub",
  "version": "0.1.0",
  "identifier": "com.fernandoluz.flhub",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "FL Hub", "width": 1040, "height": 700, "minWidth": 820, "minHeight": 560, "resizable": true, "center": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "10.15" },
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["PortugueseBR"] } },
    "shortDescription": "Instalador dos packs FL para CapCut",
    "copyright": "© Fernando Luz"
  }
}
